# Builds MControlCenter from this source tree:
#   cd packaging/arch && makepkg -si
pkgname=mcontrolcenter-katana
pkgver=0.6.0
pkgrel=6
pkgdesc="Control center for MSI laptops: performance modes, fan curves, battery limit, RGB keyboard"
arch=('x86_64')
url="https://github.com/dmitry-s93/MControlCenter"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'polkit' 'dbus' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'qt6-tools')
optdepends=('upower: automatic mode switching on charger/battery'
            'power-profiles-daemon: follow the system power profile'
            'msi-ec-dkms-git: newer msi-ec driver than the one in the kernel')
provides=('mcontrolcenter')
conflicts=('mcontrolcenter' 'mcontrolcenter-bin' 'mcontrolcenter-git')
install=mcontrolcenter.install

_srcroot="$(realpath "${startdir}/../..")"

build() {
    cmake -S "${_srcroot}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBEXECDIR=lib/mcontrolcenter
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 "${_srcroot}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
